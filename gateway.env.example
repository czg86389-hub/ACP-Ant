# ACP-Ant 网关配置（install.sh 会自动生成 gateway.env；这里列出全部可选项和默认值）
# 必填：客户端调用时的 Bearer 密钥（随机长字符串）
AGY_GATEWAY_KEY=change-me-to-a-long-random-string

# 安装目录、agy 路径、账号目录
AGY_ROOT=/opt/acp-ant
#AGY_BIN=/opt/acp-ant/bin/agy
#AGY_ACCOUNTS=/opt/acp-ant/accounts

# 每个账号同时跑几个请求（面板「设置」里改过的话以面板为准）；超出的排队。单次请求超时（秒，含排队时间）
AGY_PER_ACCOUNT=3
AGY_REQUEST_TIMEOUT=290
# 流式回复静默多少秒后发一次心跳，防止 Cloudflare 等代理 100 秒无数据断开；0 = 关闭
#AGY_HEARTBEAT=15

# 没写模型名时用哪个；额外的模型别名（JSON：{"别名": ["Antigravity 模型 id", "high|medium|low|null"]}）
#AGY_DEFAULT_MODEL=gemini-3.8-flash-medium
#AGY_MODEL_ALIASES={"fast": ["gemini-3.8-flash", "low"], "claude-haiku-5-5": ["gemini-3.8-flash", "low"]}
# Agent 请求了 Antigravity 没有的模型名时：1 = 改用 AGY_DEFAULT_MODEL；0 = 返回错误
#AGY_MODEL_FALLBACK=1

# 每次请求最多带几张图（实测 Gemini 3.8 Flash 一次 200 张全看到、250 张上游报错）。最新一条消息里的图从不丢弃，超过就返回 400；
# 只有更早轮次的图会给新图让位（从最早的开始，换成一句说明）。是否下载客户端发来的 http(s) 图片链接
#AGY_MAX_IMAGES=200
#AGY_FETCH_IMAGES=1

# 视频模式（试验功能，默认关）：1 = Gemini 模型可以看视频、听音频、读 PDF（只收请求里直接带的 base64 文件，不下载链接）。
# 每个账号会多一个只在这类请求里使用的 agy 进程，它只有 read_file 一个工具，HOME / 临时目录 / 工作目录都是专用空目录；
# 附件写到每次请求随机命名的目录里，请求结束就删。说明见 README「视频模式」
#AGY_VIDEO_MODE=0
# 哪些模型可以用（正则，按 Antigravity 的模型 id 匹配）；单个文件最大多少 MB；一次请求最多几个文件
#AGY_VIDEO_MODELS=^gemini-
#AGY_VIDEO_MAX_MB=40
#AGY_VIDEO_MAX_FILES=5

# 出错后账号歇多久（秒）：额度用完 / 限速 / 被 Google 要求验证
#AGY_COOLDOWN_QUOTA=1800
#AGY_COOLDOWN_RATE=90
#AGY_COOLDOWN_VERIFY=600

# 每个账号一个常驻 agy 进程，所有会话共用（新建会话约 0.02 秒）；1 = 改回每个会话单独起一个进程（每次多约 2 秒）
#AGY_PROCESS_PER_SESSION=0
# 常驻进程累计处理这么多个会话后，在空闲时自动换一个新进程
#AGY_RECYCLE_SESSIONS=500

# 本地会话记录保留几小时（agy 每次对话都会存一份；0 = 不清理）
AGY_KEEP_HOURS=6

# 1 = 每个账号必须有 proxy.env 才启用；0（默认，1.4.0 起）= 代理可选，没有就走服务器本机网络
#AGY_REQUIRE_PROXY=0

# 网关在账号目录里注册的 agent 名字
#AGY_AGENT=acpant

# 网页控制面板（GET / ）的管理员密码：不设置时，第一次启动随机生成并写到 $AGY_ROOT/panel-initial-password.txt
#AGY_PANEL_PASSWORD=

# 版本更新提醒：每隔几小时读一次 GitHub 上的 CHANGELOG.md（只读取，不上传数据）；0 = 不检查。用自己的 fork 时改仓库名
#ACPANT_UPDATE_CHECK_HOURS=6
#ACPANT_UPDATE_REPO=czg86389-hub/ACP-Ant
#ACPANT_UPDATE_BRANCH=main
